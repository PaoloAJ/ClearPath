# Copy to .env and fill in. Never commit .env.

# HTTP port
PORT=8080

# Postgres connection string (local Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Clerk secret key, used to verify session tokens (Clerk dashboard → API keys)
CLERK_SECRET_KEY=your-clerk-secret-key

# How often to reload the graph from the DB
GRAPH_RELOAD_INTERVAL=5m

# How often to refresh active alerts and elevator status
BARRIER_REFRESH_INTERVAL=15s
