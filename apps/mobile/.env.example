# Copy to .env and fill in. Never commit .env.
# On a physical phone, use your computer's LAN IP instead of localhost.

# Clerk publishable key (Clerk dashboard → API keys)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key

# Supabase API URL (local: http://<lan-ip>:54321)
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.10:54321

# Supabase anon/publishable key (`supabase status` prints the local one)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Go routing API base URL (local: http://<lan-ip>:8080)
EXPO_PUBLIC_ROUTING_API_URL=http://192.168.1.10:8080

# true to show the demo-mode panel (long-press the ClearPath logo)
EXPO_PUBLIC_DEMO_MODE=false
